@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SelectedRole" class="form-label"></label>
                <div class="d-grid gap-2">
                    <input type="radio" class="btn-check" asp-for="SelectedRole" value="Manager" id="profile-manager" />
                    <label class="btn btn-outline-dark text-start" for="profile-manager">Manager — Management Access</label>

                    <input type="radio" class="btn-check" asp-for="SelectedRole" value="Staff" id="profile-staff" />
                    <label class="btn btn-outline-dark text-start" for="profile-staff">Staff — Reservation Operations</label>

                    <input type="radio" class="btn-check" asp-for="SelectedRole" value="Member" id="profile-member" />
                    <label class="btn btn-outline-dark text-start" for="profile-member">Member — Customer Account</label>
                </div>
                <span asp-validation-for="SelectedRole" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <div class="mb-3">
                <input type="submit" value="Log in" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Register">Register as a member</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
