@model Area

@{
    ViewData["Title"] = "Delete Area";
}

<h1>Delete Area</h1>

<h3>Are you sure you want to delete this area?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Area Name</dt>
        <dd class="col-sm-10">@Model.AreaName</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.AreaID">
        <input type="hidden" asp-for="AreaID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
