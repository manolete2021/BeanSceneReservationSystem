@model Table

@{
    ViewData["Title"] = "Delete Table";
}

<h1>Delete Table</h1>

<h3>Are you sure you want to delete this table?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Table Number</dt>
        <dd class="col-sm-10">@Model.TableNumber</dd>

        <dt class="col-sm-2">Area</dt>
        <dd class="col-sm-10">@ViewBag.AreaName</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        <dt class="col-sm-2">Available</dt>
        <dd class="col-sm-10">@(Model.IsAvailable ? "Yes" : "No")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.TableID">
        <input type="hidden" asp-for="TableID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
