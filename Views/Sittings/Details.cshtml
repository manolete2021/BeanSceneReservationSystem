@model Sitting

@{
    ViewData["Title"] = "Sitting Details";
}

<h1>Sitting Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Sitting Type</dt>
        <dd class="col-sm-10">@Model.SittingType</dd>

        <dt class="col-sm-2">Start Time</dt>
        <dd class="col-sm-10">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">End Time</dt>
        <dd class="col-sm-10">@Model.EndTime.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        <dt class="col-sm-2">Closed</dt>
        <dd class="col-sm-10">@(Model.IsClosed ? "Yes" : "No")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.SittingID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
