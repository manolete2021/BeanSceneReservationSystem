@model IEnumerable<Sitting>

@{
    ViewData["Title"] = "Sittings";
}

<h1>Sittings</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Sitting Type</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Capacity</th>
            <th>Closed</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SittingType</td>
                <td>@item.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Capacity</td>
                <td>@(item.IsClosed ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.SittingID">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.SittingID">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.SittingID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
