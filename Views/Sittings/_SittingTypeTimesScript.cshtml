<script>
    (function () {
        var sittingType = document.getElementById('sittingType');
        var startTime = document.getElementById('startTime');
        var endTime = document.getElementById('endTime');

        if (!sittingType || !startTime || !endTime) {
            return;
        }

        var defaultTimes = {
            Breakfast: { start: '08:00', end: '11:00' },
            Lunch: { start: '12:00', end: '15:00' },
            Dinner: { start: '18:00', end: '22:00' }
        };

        sittingType.addEventListener('change', function () {
            var times = defaultTimes[sittingType.value];
            if (times) {
                startTime.value = times.start;
                endTime.value = times.end;
            }
        });
    })();
</script>
