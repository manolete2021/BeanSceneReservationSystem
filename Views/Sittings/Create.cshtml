@model SittingViewModel

@{
    ViewData["Title"] = "Create Sitting";
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var hasTimes = Model.StartTime != TimeSpan.Zero || Model.EndTime != TimeSpan.Zero;
    var selectedStart = hasTimes ? Model.StartTime.ToString(@"hh\:mm") : "";
    var selectedEnd = hasTimes ? Model.EndTime.ToString(@"hh\:mm") : "";
    var showCustomSittingType = Model.SittingType == "Other / Special Event...";
}

<h1>Create Sitting</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SittingType" class="form-label">Sitting Type</label>
                <select asp-for="SittingType" id="sittingType" class="form-select" required>
                    <option value="">-- Select Sitting Type --</option>
                    <option value="Breakfast">Breakfast</option>
                    <option value="Lunch">Lunch</option>
                    <option value="Dinner">Dinner</option>
                    <option value="Other / Special Event...">Other / Special Event...</option>
                </select>
                <span asp-validation-for="SittingType" class="text-danger"></span>
            </div>
            <div class="mb-3 @(showCustomSittingType ? "" : "d-none")" id="customSittingTypeGroup">
                <label for="customSittingType" class="form-label">Custom Sitting Type</label>
                <input asp-for="CustomSittingType" id="customSittingType" class="form-control" placeholder="Example: Happy Birthday" />
                <span asp-validation-for="CustomSittingType" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Date" class="form-label">Date</label>
                <input asp-for="Date" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" min="@minDate" required />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StartTime" class="form-label">Start Time</label>
                <select name="StartTime" id="startTime" class="form-select" required>
                    <option value="">-- Select Start Time --</option>
                    @foreach (var option in ViewBag.TimeOptions)
                    {
                        if (option.Value == selectedStart)
                        {
                            <option value="@option.Value" selected="selected">@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EndTime" class="form-label">End Time</label>
                <select name="EndTime" id="endTime" class="form-select" required>
                    <option value="">-- Select End Time --</option>
                    @foreach (var option in ViewBag.TimeOptions)
                    {
                        if (option.Value == selectedEnd)
                        {
                            <option value="@option.Value" selected="selected">@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Capacity" class="form-label">Capacity</label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" required />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsClosed" class="form-check-input" />
                <label asp-for="IsClosed" class="form-check-label">Closed</label>
            </div>
            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_SittingTypeTimesScript" />
    <script>
        (function () {
            var sittingType = document.getElementById('sittingType');
            var customGroup = document.getElementById('customSittingTypeGroup');
            var customInput = document.getElementById('customSittingType');
            var otherOption = 'Other / Special Event...';

            if (!sittingType || !customGroup || !customInput) {
                return;
            }

            function updateCustomSittingType() {
                var showCustom = sittingType.value === otherOption;
                customGroup.classList.toggle('d-none', !showCustom);

                if (showCustom) {
                    customInput.setAttribute('required', 'required');
                } else {
                    customInput.removeAttribute('required');
                    customInput.value = '';
                }
            }

            sittingType.addEventListener('change', updateCustomSittingType);
            updateCustomSittingType();
        })();
    </script>
}
