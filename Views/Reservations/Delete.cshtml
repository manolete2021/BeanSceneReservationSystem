@model Reservation

@{
    ViewData["Title"] = "Delete Reservation";
}

<h1>Delete Reservation</h1>

<h3>Are you sure you want to delete this reservation?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Customer</dt>
        <dd class="col-sm-10">@ViewBag.CustomerName</dd>

        <dt class="col-sm-2">Sitting</dt>
        <dd class="col-sm-10">@ViewBag.SittingLabel</dd>

        <dt class="col-sm-2">Start Time</dt>
        <dd class="col-sm-10">@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">Duration</dt>
        <dd class="col-sm-10">@Model.Duration</dd>

        <dt class="col-sm-2">Number of Guests</dt>
        <dd class="col-sm-10">@Model.NumberOfGuests</dd>

        <dt class="col-sm-2">Source</dt>
        <dd class="col-sm-10">@Model.Source</dd>

        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">@Model.Notes</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.ReservationID">
        <input type="hidden" asp-for="ReservationID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
